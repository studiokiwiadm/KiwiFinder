# Copie para .env e preencha. O .env está no .gitignore e NUNCA vai para o
# repositório — estes valores são segredos de verdade.
#
# Nada disso é necessário para rodar em casa: sem estas variáveis, o app grava
# em dados/kiwifinder.json e abre sem senha, exatamente como sempre fez.

# ---- senha da tela ----------------------------------------------------------
# Só existe quando preenchida. Online ela é obrigatória: sem senha, qualquer um
# com o endereço vê seus produtos, cadastra loja e dispara rodada.
KIWI_SENHA=

# Assina o cookie de sessão. Qualquer texto longo e aleatório serve. Se ficar
# vazio, um é sorteado a cada início — e você é deslogado a cada reinício.
SESSION_SECRET=

# ---- banco (Supabase) -------------------------------------------------------
# Painel do Supabase -> Project Settings -> API
#   SUPABASE_URL         "Project URL"      https://xxxx.supabase.co
#   SUPABASE_SERVICE_KEY "service_role"     (a secreta, NÃO a anon)
#
# A service_role passa por cima do RLS. Ela nunca chega ao navegador: só o
# servidor a usa. Se vazar, quem tiver a chave lê e escreve o banco inteiro.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
